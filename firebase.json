{
  "hosting": {
    "site": "fukkarulp",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/profile",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/profile.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/profile/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/contact",
        "destination": "/#contact",
        "type": 301
      },
      {
        "source": "/contact/",
        "destination": "/#contact",
        "type": 301
      },
      {
        "source": "/contact.html",
        "destination": "/#contact",
        "type": 301
      },
      {
        "source": "/contact.php",
        "destination": "/#contact",
        "type": 301
      },
      {
        "source": "/contact/index.html",
        "destination": "/#contact",
        "type": 301
      },
      {
        "source": "/inquiry",
        "destination": "/#contact",
        "type": 301
      },
      {
        "source": "/inquiry/",
        "destination": "/#contact",
        "type": 301
      },
      {
        "source": "/form",
        "destination": "/#contact",
        "type": 301
      },
      {
        "source": "/form/",
        "destination": "/#contact",
        "type": 301
      },
      {
        "source": "/kiji-jidouka",
        "destination": "/autoblog",
        "type": 301
      },
      {
        "source": "/kiji-jidouka.html",
        "destination": "/autoblog",
        "type": 301
      },
      {
        "source": "/web.html",
        "destination": "/hp-seisaku",
        "type": 301
      },
      {
        "source": "/profile.html",
        "destination": "/profile",
        "type": 301
      },
      {
        "source": "/service",
        "destination": "/blog/service/",
        "type": 301
      },
      {
        "source": "/service/",
        "destination": "/blog/service/",
        "type": 301
      },
      {
        "source": "/service/kusakari",
        "destination": "/blog/kusakari/",
        "type": 301
      },
      {
        "source": "/service/kusakari/",
        "destination": "/blog/kusakari/",
        "type": 301
      },
      {
        "source": "/service/kagu-kumitate",
        "destination": "/blog/kagu-kumitate/",
        "type": 301
      },
      {
        "source": "/service/kagu-kumitate/",
        "destination": "/blog/kagu-kumitate/",
        "type": 301
      },
      {
        "source": "/service/monooki",
        "destination": "/blog/monooki/",
        "type": 301
      },
      {
        "source": "/service/monooki/",
        "destination": "/blog/monooki/",
        "type": 301
      },
      {
        "source": "/service/senjo",
        "destination": "/blog/senjo/",
        "type": 301
      },
      {
        "source": "/service/senjo/",
        "destination": "/blog/senjo/",
        "type": 301
      },
      {
        "source": "/service/kaimono",
        "destination": "/blog/kaimono/",
        "type": 301
      },
      {
        "source": "/service/kaimono/",
        "destination": "/blog/kaimono/",
        "type": 301
      },
      {
        "source": "/service/akiya",
        "destination": "/blog/akiya/",
        "type": 301
      },
      {
        "source": "/service/akiya/",
        "destination": "/blog/akiya/",
        "type": 301
      },
      {
        "source": "/service/fuji-gomi-dashikata",
        "destination": "/blog/fuji-gomi-dashikata/",
        "type": 301
      },
      {
        "source": "/service/fuji-gomi-dashikata/",
        "destination": "/blog/fuji-gomi-dashikata/",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/profile",
        "destination": "/profile.html"
      },
      {
        "source": "/hp-seisaku",
        "destination": "/web.html"
      },
      {
        "source": "/autoblog",
        "destination": "/kiji-jidouka.html"
      }
    ]
  }
}
